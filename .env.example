# Copiar este archivo a .env y completar valores reales antes de levantar el proyecto
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
CONSUL_URL=http://consul:8500
INTERNAL_SERVICE_TOKEN=cambia-este-token-interno-por-uno-largo-y-aleatorio
JSON_BODY_LIMIT=100kb
CORS_ORIGIN=*

# Credenciales de Mongo (usadas por docker-compose y por cada servicio)
MONGO_USUARIOS_USER=usuarios_app
MONGO_USUARIOS_PASS=usuarios_pass
MONGO_PRODUCTOS_USER=productos_app
MONGO_PRODUCTOS_PASS=productos_pass
MONGO_PEDIDOS_USER=pedidos_app
MONGO_PEDIDOS_PASS=pedidos_pass
