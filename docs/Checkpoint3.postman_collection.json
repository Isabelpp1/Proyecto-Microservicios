{
  "info": {
    "_postman_id": "f7f85d6a-7d77-4f96-9f13-checkpoint3",
    "name": "Proyecto Microservicios - Checkpoint 3 final",
    "description": "Demo final del sistema de pedidos. No contiene JWT_SECRET, credenciales Mongo ni INTERNAL_SERVICE_TOKEN.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "demoEmail", "value": "" },
    { "key": "demoPassword", "value": "ClaveSegura123" },
    { "key": "jwtToken", "value": "" },
    { "key": "usuarioId", "value": "" },
    { "key": "productoId", "value": "" },
    { "key": "pedidoId", "value": "" },
    { "key": "idempotencyKey", "value": "" }
  ],
  "item": [
    {
      "name": "1 - Salud y discovery",
      "item": [
        {
          "name": "Gateway healthz",
          "request": { "method": "GET", "url": "{{baseUrl}}/healthz" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Gateway disponible', () => pm.response.to.have.status(200));",
            "pm.expect(pm.response.json().status).to.eql('ok');"
          ] } }]
        },
        {
          "name": "Usuarios healthz",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/usuarios/healthz" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Usuarios disponible', () => pm.response.to.have.status(200));"
          ] } }]
        },
        {
          "name": "Productos readiness",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/productos/readyz" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Productos y Mongo listos', () => pm.response.to.have.status(200));"
          ] } }]
        },
        {
          "name": "Pedidos readiness",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/pedidos/readyz" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Pedidos y Mongo listos', () => pm.response.to.have.status(200));"
          ] } }]
        }
      ]
    },
    {
      "name": "2 - Flujo principal",
      "item": [
        {
          "name": "Registrar usuario",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "pm.collectionVariables.set('demoEmail', 'checkpoint3.' + Date.now() + '@example.com');"
            ] } },
            { "listen": "test", "script": { "exec": [
              "pm.test('Usuario creado', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('usuarioId', pm.response.json().id);"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Usuario Checkpoint 3\",\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}" },
            "url": "{{baseUrl}}/api/usuarios/register"
          }
        },
        {
          "name": "Login y guardar JWT",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Login correcto', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('jwtToken', pm.response.json().token);",
            "pm.expect(pm.response.json().token).to.exist;"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}" },
            "url": "{{baseUrl}}/api/usuarios/login"
          }
        },
        {
          "name": "Login incorrecto",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"incorrecta\"\n}" },
            "url": "{{baseUrl}}/api/usuarios/login"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Credenciales inválidas', () => pm.response.to.have.status(401));"
          ] } }]
        },
        {
          "name": "Crear producto stock 3",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Producto creado', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('productoId', pm.response.json()._id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Producto Checkpoint 3\",\n  \"descripcion\": \"Producto de demostración\",\n  \"precio\": 12.5,\n  \"stock\": 3\n}" },
            "url": "{{baseUrl}}/api/productos"
          }
        },
        {
          "name": "Pedido sin JWT",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"items\": [{ \"productoId\": \"{{productoId}}\", \"cantidad\": 1 }]\n}" },
            "url": "{{baseUrl}}/api/pedidos"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('JWT requerido', () => pm.response.to.have.status(401));",
            "pm.expect(pm.response.json().code).to.eql('AUTH_REQUIRED');"
          ] } }]
        },
        {
          "name": "Pedido válido con reserva",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "pm.collectionVariables.set('idempotencyKey', 'pedido-' + Date.now());"
            ] } },
            { "listen": "test", "script": { "exec": [
              "pm.test('Pedido confirmado', () => pm.response.to.have.status(201));",
              "pm.expect(pm.response.json().estado).to.eql('confirmado');",
              "pm.expect(pm.response.json().total).to.eql(25);",
              "pm.collectionVariables.set('pedidoId', pm.response.json()._id);"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" },
              { "key": "x-correlation-id", "value": "postman-checkpoint3-001" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"items\": [{ \"productoId\": \"{{productoId}}\", \"cantidad\": 2 }]\n}" },
            "url": "{{baseUrl}}/api/pedidos"
          }
        },
        {
          "name": "Replay idempotente",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"items\": [{ \"productoId\": \"{{productoId}}\", \"cantidad\": 2 }]\n}" },
            "url": "{{baseUrl}}/api/pedidos"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Replay devuelve 200', () => pm.response.to.have.status(200));",
            "pm.expect(String(pm.response.json()._id)).to.eql(String(pm.collectionVariables.get('pedidoId')));"
          ] } }]
        },
        {
          "name": "Verificar stock restante 1",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/productos/{{productoId}}" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Stock reservado una sola vez', () => pm.expect(pm.response.json().stock).to.eql(1));"
          ] } }]
        },
        {
          "name": "Consultar pedido",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/pedidos/{{pedidoId}}" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Pedido consultable', () => pm.response.to.have.status(200));"
          ] } }]
        }
      ]
    },
    {
      "name": "3 - Rechazos sin mutación",
      "item": [
        {
          "name": "Stock insuficiente",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Idempotency-Key", "value": "stock-error-{{productoId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"items\": [{ \"productoId\": \"{{productoId}}\", \"cantidad\": 99 }]\n}" },
            "url": "{{baseUrl}}/api/pedidos"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Stock insuficiente responde 409', () => pm.response.to.have.status(409));",
            "pm.expect(pm.response.json().code).to.eql('STOCK_INSUFFICIENT');"
          ] } }]
        },
        {
          "name": "Payload inválido",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"items\": [{ \"productoId\": \"no-es-id\", \"cantidad\": 0 }]\n}" },
            "url": "{{baseUrl}}/api/pedidos"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Payload inválido responde 400', () => pm.response.to.have.status(400));",
            "pm.expect(pm.response.json().code).to.eql('VALIDATION_ERROR');"
          ] } }]
        },
        {
          "name": "Conflicto de idempotencia",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"items\": [{ \"productoId\": \"{{productoId}}\", \"cantidad\": 1 }]\n}" },
            "url": "{{baseUrl}}/api/pedidos"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Payload diferente con misma clave responde 409', () => pm.response.to.have.status(409));",
            "pm.expect(pm.response.json().code).to.eql('IDEMPOTENCY_CONFLICT');"
          ] } }]
        }
      ]
    }
  ]
}
